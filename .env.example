# 기상청 기상특보 조회서비스 일반 인증키(URL 인코딩된 값)
KMA_SERVICE_KEY=
# 세션 서명 키 (임의의 긴 문자열)
SESSION_SECRET=
# Neon Postgres (Vercel Marketplace 연결 시 자동 주입). 비우면 로컬 PGlite 사용
DATABASE_URL=
# Vercel Blob (자동 주입)
BLOB_READ_WRITE_TOKEN=
# 휴지통 정리 크론 보호용
CRON_SECRET=
# T3Q 연계: mock(시드 응답) | live(실제 API)
T3Q_MODE=mock
T3Q_BASE_URL=
T3Q_TOKEN=
