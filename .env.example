# 기상청 기상특보 조회서비스 일반 인증키(URL 인코딩된 값)
KMA_SERVICE_KEY=
# 세션 서명 키 (임의의 긴 문자열)
SESSION_SECRET=
# Neon Postgres (Vercel Marketplace 연결 시 자동 주입). 비우면 로컬 PGlite 사용
DATABASE_URL=
# Vercel Blob (자동 주입)
BLOB_READ_WRITE_TOKEN=
# 휴지통 정리 크론 보호용
CRON_SECRET=
# T3Q SOP(API-02, 납품 v2): mock(매뉴얼 시드) | live(실제 API). 주소 예: https://plf.mois-disaster.t3q.ai/model-api/4920a
T3Q_SOP_MODE=mock
T3Q_SOP_URL=
# T3Q 서버 인증서가 사설 인증기관 발급이라 둘 중 하나로 믿는다(검증을 끄지 않음). 공인 인증서로 바뀌면 둘 다 비움
#  - 지문 고정: 서버 인증서 SHA-256 지문(쉼표로 여러 개). 인증서가 갱신되면 새 지문으로 교체
T3Q_SOP_CERT_SHA256=
#  - 루트 인증서: T3Q 루트 인증서 PEM 본문(줄바꿈은 
). 있으면 지문보다 우선 — 회사 서버에서는 NODE_EXTRA_CA_CERTS 로 대신해도 됨
T3Q_SOP_CA=
# T3Q 링크 로그인(API-03) — 아직 T3Q 미제공(요청안): mock | live. 연락망은 T3Q 연계 없이 엑셀·직접 입력
T3Q_MODE=mock
T3Q_BASE_URL=
T3Q_TOKEN=

# 시험 기간 로그인 안내 "아이디:비밀번호" — 설정하면 로그인 화면에 아이디를 채우고 비밀번호를 표시. 정식 배포 전 삭제
DEMO_LOGIN=
